<div class="w-100 p-3">
  <h1>Orders</h1>
  <table class="table table-bordered">
    <thead>
    <tr>
      <th>Order ID</th>
      <th>Product Name</th>
      <th>State</th>
      <th>Order Emails and AI</th>
    </tr>
    </thead>
    <tbody>
    <% @orders.each do |order| %>
      <tr>
        <td><%= order.id %></td>
        <td><%= order.product_name %></td>
        <td><%= order.state %></td>
        <td><%= link_to 'See Emails and AI', order_path(id: order.id) %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>
