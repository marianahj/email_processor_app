<div class="w-100 p-3">
  <div class="row">
    <div class="col-md-8">
      <h1>Email Inbox</h1>
    </div>
    <div class="col-md-4">
      <ul style="list-style: none; padding: 0; display: flex; gap: 15px;">
        <li><%= link_to "Home", root_path %></li>
        <li><%= link_to "Processed Emails", processed_emails_path %></li>
      </ul>
    </div>

  </div>

  <div>
    <p>This table includes all the emails that have been imported. This can be change to display only the emails that hasn't been processed.</p>
    <p>The column <strong>Body</strong> is only displaying 300 characters.</p>
    <p>Click the button "Process with AI" to get the email processed.</p>
  </div>

  <table class="table table-bordered">
    <thead>
    <tr>
      <th>Email ID</th>
      <th>Sender</th>
      <th>Subject</th>
      <th>Email Body</th>
      <th>Received At</th>
      <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    <% @emails.each do |email| %>
      <tr>
        <td><%= email.id %></td>
        <td><%= email.sender %></td>
        <td><%= email.subject %></td>
        <td><%= email.body %></td>
        <td><%= email.created_at.strftime("%b %d, %Y %H:%M") %></td>
        <td>
          <%= button_to "Process with AI", analyze_emails_path(email_id: email.id), method: :post, class: "btn btn-success" %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>

