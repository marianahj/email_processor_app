<h1>Email Details</h1>

<p><strong>From:</strong> <%= @email.sender %></p>
<p><strong>Subject:</strong> <%= @email.subject %></p>
<p><strong>Body:</strong></p>
<pre><%= @email.body %></pre>

<% if @email.processed_summary.present? %>
  <h2>AI Summary</h2>
  <p><%= @email.processed_summary %></p>
<% else %>
  <p><em>No AI summary available yet.</em></p>
<% end %>

<%= button_to "Process with AI", process_emails_path(email_id: @email.id), method: :post, class: "btn btn-success" %>
<%= link_to "Back to Inbox", emails_path, class: "btn btn-secondary" %>